# Copy to .env (git-ignored) and fill in.  Keep .env private: chmod 600 .env
#
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> your tunnel -> install command:
# the long string after "--token".
# Only for docker-compose.yml and scripts/serve.ps1 (Cloudflare Tunnel).
TUNNEL_TOKEN=

# Cloudflare dashboard -> Turnstile -> your widget -> "Secret Key".
# When set, only the website (after a human check) can solve.  Empty = no human check.
# The matching public "Site Key" goes into web/config.js (turnstileSiteKey).
TURNSTILE_SECRET=

# Sites that may call the API from a browser (comma-separated).
ALLOWED_ORIGINS=https://lunar.rtang.dev

# Rate limits per visitor IP: count/seconds.
RATE_SOLVE=6/60
RATE_LOOKUP=60/60

# 1 = serve the interactive API docs at /docs.  Keep 0 on a public server.
ENABLE_DOCS=0

# Hugging Face dataset with the solver data (server/fetch_data.py).
LUNARSOLVE_DATA_REPO=turtlely/lunarsolve-data

# CPU threads for the detector, and the memory limit of the API container (Docker only).
THREADS=4
MEM_LIMIT=7g

# Public host name of the API, for docker-compose.caddy.yml (DNS A record -> this server).
DOMAIN=
